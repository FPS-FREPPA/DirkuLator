 UpdateDescriptorQueue::~UpdateDescriptorQueue() = default;
 
 void UpdateDescriptorQueue::TickFrame() {
+    // 042: the largest frame of each queue, every 1024 frames (EDEN_DESCRIPTOR_PEAK).
+    const size_t used = static_cast<size_t>(std::distance(payload_start, payload_cursor));
+    peak_entries = (std::max)(peak_entries, used);
+    if (++peak_frames >= 1024) {
+        LOG_INFO(Render_Vulkan, "EDEN_DESCRIPTOR_PEAK capacity={} peak={} frames={}", frame_payload_size,
+                 peak_entries, peak_frames);
+        peak_entries = 0;
+        peak_frames = 0;
+    }
     if (++frame_index >= FRAMES_IN_FLIGHT) {
         frame_index = 0;
     }
