 template <class P>
+template <typename Fill>
+void TextureCache<P>::UploadInPieces(Image& image, std::span<const BufferImageCopy> copies, u64 total,
+                                     Fill&& fill) {
+    // 0.5.13: a whole image needs one staging block of its size. After Saria's wave the pool had
+    // none of 48 MiB (0.5.12 ended at 1070 s with blocks of at most 40 MiB). The same copies go in
+    // staging buffers of at most 16 MiB: whole copies together, a larger copy by layer or slice.
+    constexpr u64 piece_size = 16_MiB;
+    struct Unit {
+        BufferImageCopy copy;
+        u64 source;
+        u64 size;
+    };
+    std::vector<Unit> units;
+    units.reserve(copies.size());
+    for (size_t index = 0; index < copies.size(); ++index) {
+        const BufferImageCopy& copy = copies[index];
+        const u64 end = index + 1 < copies.size() ? copies[index + 1].buffer_offset : total;
+        const u64 size = end > copy.buffer_offset ? end - copy.buffer_offset : 0;
+        const u32 layers = static_cast<u32>((std::max)(copy.image_subresource.num_layers, 1));
+        const u32 depth = (std::max)(copy.image_extent.depth, 1U);
+        const u32 slices = size <= piece_size ? 1U : layers > 1 ? layers : depth;
+        if (slices > 1 && size % slices == 0) {
+            const u64 slice_size = size / slices;
+            for (u32 slice = 0; slice < slices; ++slice) {
+                BufferImageCopy part = copy;
+                part.buffer_offset = copy.buffer_offset + slice * slice_size;
+                part.buffer_size = slice_size;
+                if (layers > 1) {
+                    part.image_subresource.base_layer += static_cast<s32>(slice);
+                    part.image_subresource.num_layers = 1;
+                } else {
+                    part.image_offset.z += static_cast<s32>(slice);
+                    part.image_extent.depth = 1;
+                }
+                units.push_back({part, part.buffer_offset, slice_size});
+            }
+        } else {
+            BufferImageCopy part = copy;
+            part.buffer_size = size;
+            units.push_back({part, copy.buffer_offset, size});
+        }
+    }
+    std::vector<BufferImageCopy> piece_copies;
+    for (size_t first = 0; first < units.size();) {
+        u64 bytes = units[first].size;
+        size_t last = first + 1;
+        while (last < units.size() && bytes + units[last].size <= piece_size) {
+            bytes += units[last++].size;
+        }
+        if (bytes > piece_size) {
+            static u32 logged{};
+            if (logged++ < 32) {
+                LOG_WARNING(HW_GPU, "EDEN_BIG_UPLOAD_PIECE bytes={} gpu={:#x} format={} {}x{}x{} levels={} layers={} flags={:#x}",
+                            bytes, image.gpu_addr, static_cast<u32>(image.info.format), image.info.size.width,
+                            image.info.size.height, image.info.size.depth, image.info.resources.levels,
+                            image.info.resources.layers, static_cast<u32>(image.flags));
+            }
+        }
+        if (bytes == 0) {
+            first = last;
+            continue;
+        }
+        auto staging = runtime.UploadStagingBuffer(bytes);
+        piece_copies.clear();
+        u64 at = 0;
+        for (size_t unit = first; unit < last; ++unit) {
+            fill(std::span<u8>{staging.mapped_span}.subspan(at, units[unit].size), units[unit].source);
+            BufferImageCopy copy = units[unit].copy;
+            copy.buffer_offset = at;
+            piece_copies.push_back(copy);
+            at += units[unit].size;
+        }
+        image.UploadMemory(staging, piece_copies);
+        first = last;
+    }
+}
+
+template <class P>
+bool TextureCache<P>::UploadWholeInPieces(Image& image) {
+    constexpr ImageFlagBits excluded = ImageFlagBits::Sparse | ImageFlagBits::AcceleratedUpload |
+                                       ImageFlagBits::Unbacked | ImageFlagBits::TrimmedLevels;
+    const u64 total = MapSizeBytes(image);
+    if (total <= 16_MiB) {
+        return false;
+    }
+    if (True(image.flags & excluded)) {
+        static u32 logged{};
+        if (logged++ < 32) {
+            LOG_WARNING(HW_GPU, "EDEN_BIG_UPLOAD_WHOLE bytes={} gpu={:#x} format={} {}x{}x{} levels={} layers={} flags={:#x}",
+                        total, image.gpu_addr, static_cast<u32>(image.info.format), image.info.size.width,
+                        image.info.size.height, image.info.size.depth, image.info.resources.levels,
+                        image.info.resources.layers, static_cast<u32>(image.flags));
+        }
+        return false;
+    }
+    if (True(image.flags & ImageFlagBits::Converted)) {
+        unswizzle_data_buffer.resize_destructive(image.unswizzled_size_bytes);
+        auto copies = FixSmallVectorADL(UnswizzleImage(*gpu_memory, image.gpu_addr, image.info, {},
+                                                       unswizzle_data_buffer, &swizzle_data_buffer));
+        std::vector<u8> converted;
+        try {
+            converted.resize(total);
+        } catch (const std::bad_alloc&) {
+            return false; // one staging buffer after all
+        }
+        ConvertImage(unswizzle_data_buffer, image.info, converted, copies);
+        UploadInPieces(image, std::span<const BufferImageCopy>(copies.data(), copies.size()), total,
+                       [&converted](std::span<u8> out, u64 at) {
+                           std::memcpy(out.data(), converted.data() + at, out.size());
+                       });
+    } else {
+        unswizzle_data_buffer.resize_destructive(total);
+        const auto copies = FixSmallVectorADL(UnswizzleImage(*gpu_memory, image.gpu_addr, image.info, {},
+                                                             unswizzle_data_buffer, &swizzle_data_buffer));
+        UploadInPieces(image, std::span<const BufferImageCopy>(copies.data(), copies.size()), total,
+                       [this](std::span<u8> out, u64 at) {
+                           std::memcpy(out.data(), unswizzle_data_buffer.data() + at, out.size());
+                       });
+    }
+    runtime.InsertUploadMemoryBarrier();
+    return true;
+}
