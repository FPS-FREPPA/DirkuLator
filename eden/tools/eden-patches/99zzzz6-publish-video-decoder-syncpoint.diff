+// Counters kept current in the guest's table without being asked for. A counter nobody requested
+// stays Unallocated there, and nn::syncpt reads Unallocated as "already reached".
+inline std::array<std::atomic<u64>, GroupCount> AlwaysPublished{};
+inline void PublishAlways(u32 id) {
+    if (id < CounterCount) {
+        AlwaysPublished[id / 64].fetch_or(1ULL << (id % 64), std::memory_order_relaxed);
+    }
+}
+inline void StopPublishing(u32 id) {
+    if (id < CounterCount) {
+        AlwaysPublished[id / 64].fetch_and(~(1ULL << (id % 64)), std::memory_order_relaxed);
+    }
+}
+
 struct CounterValue {
     u64 previous{Unallocated};
 
