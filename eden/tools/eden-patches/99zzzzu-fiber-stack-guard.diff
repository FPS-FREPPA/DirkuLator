+// The memory report's thread (headless/performance.cpp), every 30 s: how deep the stacks went.
+extern "C" void eden_fiber_stacks_report(void) {
+    static long long last_ns = 0;
+    const long long now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                              std::chrono::steady_clock::now().time_since_epoch())
+                              .count();
+    if (last_ns != 0 && now - last_ns < 30'000'000'000LL) {
+        return;
+    }
+    last_ns = now;
+    const size_t size = FiberStackSize();
+    size_t alive = 0, deepest_now = 0, damaged = 0;
+    for (auto& slot : stack_slots) {
+        const u8* stack = slot.load(std::memory_order_acquire);
+        if (stack == nullptr) {
+            continue;
+        }
+        ++alive;
+        damaged += StackGuardIntact(stack) ? 0 : 1;
+        size_t untouched = 0;
+        while (untouched < size && stack[untouched] == STACK_PATTERN) {
+            ++untouched;
+        }
+        deepest_now = (std::max)(deepest_now, size - untouched);
+    }
+    size_t deepest = stack_deepest.load(std::memory_order_relaxed);
+    while (deepest_now > deepest && !stack_deepest.compare_exchange_weak(deepest, deepest_now)) {
+    }
+    deepest = (std::max)(deepest, deepest_now);
+    std::fprintf(stderr, "EDEN_FIBER_STACKS alive=%zu size_kib=%zu deepest_kib=%zu deepest_now_kib=%zu damaged=%zu\n",
+                 alive, size >> 10, deepest >> 10, deepest_now >> 10, damaged);
+    std::fflush(stderr);
+}
