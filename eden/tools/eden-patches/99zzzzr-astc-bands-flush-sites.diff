     if (VideoCommon::GpuSplit::check_owner) [[unlikely]] {
         VideoCommon::GpuSplit::CheckOwner("Scheduler::Flush");
     }
+    {
+        // 035: flushes counted by caller, reported every 5 s (EDEN_FLUSH_SITE).
+        static const bool flush_sites = std::getenv("EDEN_NX2_FLUSH_SITES_OFF") == nullptr;
+        if (flush_sites) {
+            static std::array<std::pair<std::uintptr_t, u64>, 32> sites{};
+            static u64 other{};
+            static auto window = std::chrono::steady_clock::now();
+            const auto caller = reinterpret_cast<std::uintptr_t>(__builtin_return_address(0));
+            bool counted = false;
+            for (auto& [site, count] : sites) {
+                if (site == caller || site == 0) {
+                    site = caller;
+                    ++count;
+                    counted = true;
+                    break;
+                }
+            }
+            other += counted ? 0 : 1;
+            const auto now = std::chrono::steady_clock::now();
+            if (now - window >= std::chrono::seconds{5}) {
+                window = now;
+                std::sort(sites.begin(), sites.end(),
+                          [](const auto& a, const auto& b) { return a.second > b.second; });
+                const auto anchor = reinterpret_cast<std::uintptr_t>(&VideoCommon::NativeWaitProfile::Anchor);
+                for (size_t i = 0; i < 6 && sites[i].second != 0; ++i) {
+                    std::printf("EDEN_FLUSH_SITE caller=%#llx anchor=%#llx count=%llu\n",
+                                static_cast<unsigned long long>(sites[i].first),
+                                static_cast<unsigned long long>(anchor),
+                                static_cast<unsigned long long>(sites[i].second));
+                }
+                if (other != 0) {
+                    std::printf("EDEN_FLUSH_SITE caller=other count=%llu\n",
+                                static_cast<unsigned long long>(other));
+                }
+                std::fflush(stdout);
+                sites = {};
+                other = 0;
+            }
+        }
+    }
     // When flushing, we only send data to the worker thread; no waiting is necessary.
     const u64 signal_value = SubmitExecution(signal_semaphore, wait_semaphore);
     AllocateNewContext();
