+    // EDEN_SUBMIT_DEPTH (stdout, every 5 s): the submissions the GPU had not finished when each
+    // new one was made, and how long the submit call took. Mostly 0: the GPU waits for the CPU
+    // (CPU-bound). Mostly 1 or more: the GPU is behind (GPU-bound), and a long submit is the
+    // driver waiting for ring space rather than doing work.
+    Refresh();
+    const u64 known = gpu_tick.load(std::memory_order_acquire);
+    const u64 depth = host_tick > known + 1 ? host_tick - known - 1 : 0;
+    const auto started = std::chrono::steady_clock::now();
+    const VkResult result =
+        semaphore ? SubmitQueueTimeline(cmdbuf, upload_cmdbuf, signal_semaphore, wait_semaphore, host_tick)
+                  : SubmitQueueFence(cmdbuf, upload_cmdbuf, signal_semaphore, wait_semaphore, host_tick);
+    const u64 ns = static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
