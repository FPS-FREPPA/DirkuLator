+    static u64 window_start_ns{}, submits{}, depth_sum{}, depth_max{}, ns_sum{}, ns_max{};
+    static std::array<u64, 4> depth_hist{};
+    const u64 now_ns = static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                            started.time_since_epoch())
+                                            .count());
+    if (window_start_ns == 0) {
+        window_start_ns = now_ns;
+    }
+    ++submits;
+    depth_sum += depth;
+    depth_max = (std::max)(depth_max, depth);
+    ++depth_hist[(std::min)(depth, u64{3})];
+    ns_sum += ns;
+    ns_max = (std::max)(ns_max, ns);
+    if (now_ns - window_start_ns >= 5'000'000'000ULL) {
+        std::printf("EDEN_SUBMIT_DEPTH submits=%llu depth_avg=%.2f depth_max=%llu depth0=%llu depth1=%llu "
+                    "depth2=%llu depth3plus=%llu submit_ms_avg=%.2f submit_ms_max=%.2f seconds=%.2f\n",
+                    static_cast<unsigned long long>(submits), double(depth_sum) / double(submits),
+                    static_cast<unsigned long long>(depth_max), static_cast<unsigned long long>(depth_hist[0]),
+                    static_cast<unsigned long long>(depth_hist[1]), static_cast<unsigned long long>(depth_hist[2]),
+                    static_cast<unsigned long long>(depth_hist[3]), double(ns_sum) / double(submits) / 1e6,
+                    double(ns_max) / 1e6, double(now_ns - window_start_ns) / 1e9);
+        std::fflush(stdout);
+        window_start_ns = now_ns;
+        submits = depth_sum = depth_max = ns_sum = ns_max = 0;
+        depth_hist = {};
     }
+    return result;
