 /// Called when a native shader is lowered: remembers which key the program at this address has.
 inline void RecordProgram(u64 program_address, u64 key) {
-    if (!Enabled()) return;
     auto& table = Programs();
     std::scoped_lock lock{table.mutex};
     table.key_by_address[program_address] = key;
 }
 
+/// The key of the native program lowered at this address, 0 when none was.
+inline u64 KeyAt(u64 program_address) {
+    auto& table = Programs();
+    std::scoped_lock lock{table.mutex};
+    const auto it = table.key_by_address.find(program_address);
+    return it == table.key_by_address.end() ? 0 : it->second;
+}
+
+/// 051: probe lines that must survive a crash. After a crash the app restarts itself and the restart
+/// empties eden_log.txt, so each line is also appended to /data/eden-nx2/logs/depth-samplers.txt
+/// (truncated at the first line of a run, flushed per line).
+inline void DepthLog(const std::string& line) {
+    static std::mutex mutex;
+    static std::ofstream file("/data/eden-nx2/logs/depth-samplers.txt", std::ios::trunc);
+    std::scoped_lock lock{mutex};
+    file << line << '\n';
+    file.flush();
+}
+
