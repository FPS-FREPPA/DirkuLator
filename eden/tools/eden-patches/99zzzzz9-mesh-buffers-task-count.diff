DirkuLator 0.4: mesh/task emulation fixes from Lichii (2026-11-12). (1) db7a53c1e/#1452: hold the draw's mesh-emulation
staging buffers until its commands are recorded and free them at that tick; mark the task arena used by the writing
submission. (2) 4765047cd/#1492 extended to the compute fallback: every task invocation zeroes the mesh workgroup count
(payload word 1) at entry. Diagnostics of 0.2/0.3 kept.

diff --git a/src/shader_recompiler/backend/spirv/emit_spirv_mesh.cpp b/src/shader_recompiler/backend/spirv/emit_spirv_mesh.cpp
--- a/src/shader_recompiler/backend/spirv/emit_spirv_mesh.cpp
+++ b/src/shader_recompiler/backend/spirv/emit_spirv_mesh.cpp
@@ -347,6 +347,11 @@
     // No branches here: the entry block's label is a phi predecessor for later blocks.
     const bool as_compute{ctx.runtime_info.mesh_as_compute};
     if (ctx.stage == Stage::Task) {
+        // A task that never writes its mesh workgroup count (all its threads culled, or a path without
+        // the store) must launch none: the payload starts undefined. Every invocation stores the zero
+        // (upstream 8e87cf5a66, Lichii #1492; the compute fallback copies this word in ComputeTaskEpilogue).
+        ctx.OpStore(PayloadWord(ctx, ctx.Const(1U)), ctx.u32_zero_value);
+        Barrier(ctx);
         if (!as_compute) {
             return;
         }
