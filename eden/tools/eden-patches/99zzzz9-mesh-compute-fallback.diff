+    // that do not fit are not dispatched, which loses geometry instead of the game.
+    const u64 max_size{(std::min)(u64{128} << 20, u64{device.GetMaxStorageBufferRange()})};
+#else
+    const u64 max_size{(std::min)(u64{1} << 30, u64{device.GetMaxStorageBufferRange()})};
+#endif
