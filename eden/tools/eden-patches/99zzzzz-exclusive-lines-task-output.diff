Build 047:
- One behaviour change, from Lichii fd9c0133d (#1331): the exclusive monitor keeps each processor's reservation
  (address and value) in its own 64-byte aligned entry, instead of all six packed into one or two cache lines
  that guest atomics on any two cores bounced between (x64 backend + interface).
- Diagnostics only: EDEN_TASK_OUTPUT (per submission with emulated task draws: task workgroups, mesh output words
  from the arena counter, mesh groups per task) and EDEN_MESH_WARP (whether the emulation's compute pipelines get
  the guest 32-thread warp).

diff --git a/src/dynarmic/src/dynarmic/backend/x64/exclusive_monitor.cpp b/src/dynarmic/src/dynarmic/backend/x64/exclusive_monitor.cpp
--- a/src/dynarmic/src/dynarmic/backend/x64/exclusive_monitor.cpp
+++ b/src/dynarmic/src/dynarmic/backend/x64/exclusive_monitor.cpp
@@ -15,10 +15,10 @@
 namespace Dynarmic {
 
 ExclusiveMonitor::ExclusiveMonitor(std::size_t processor_count)
-        : exclusive_addresses(processor_count, INVALID_EXCLUSIVE_ADDRESS), exclusive_values(processor_count) {}
+        : reservations(processor_count) {}
 
 size_t ExclusiveMonitor::GetProcessorCount() const {
-    return exclusive_addresses.size();
+    return reservations.size();
 }
 
 void ExclusiveMonitor::Lock() {
@@ -32,25 +32,27 @@
 bool ExclusiveMonitor::CheckAndClear(std::size_t processor_id, VAddr address) {
     const VAddr masked_address = address & RESERVATION_GRANULE_MASK;
     Lock();
-    if (exclusive_addresses[processor_id] != masked_address) {
+    if (reservations[processor_id].address != masked_address) {
         Unlock();
         return false;
     }
-    for (VAddr& other_address : exclusive_addresses)
-        if (other_address == masked_address)
-            other_address = INVALID_EXCLUSIVE_ADDRESS;
+    for (Reservation& other : reservations)
+        if (other.address == masked_address)
+            other.address = INVALID_EXCLUSIVE_ADDRESS;
     return true;
 }
 
 void ExclusiveMonitor::Clear() {
     Lock();
-    std::fill(exclusive_addresses.begin(), exclusive_addresses.end(), INVALID_EXCLUSIVE_ADDRESS);
+    for (Reservation& other : reservations) {
+        other.address = INVALID_EXCLUSIVE_ADDRESS;
+    }
     Unlock();
 }
 
 void ExclusiveMonitor::ClearProcessor(size_t processor_id) {
     Lock();
-    exclusive_addresses[processor_id] = INVALID_EXCLUSIVE_ADDRESS;
+    reservations[processor_id].address = INVALID_EXCLUSIVE_ADDRESS;
     Unlock();
 }
 
