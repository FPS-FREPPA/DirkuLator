DirkuLator 0.5.5: mesh emulation arenas start at 8 MiB instead of 64 MiB (task output per submission at most 4.6 MiB,
arenas still grow on demand); EDEN_BIG_UPLOAD logs upload staging requests over 16 MiB with cache kind and caller.

diff --git a/src/video_core/renderer_vulkan/vk_buffer_cache.cpp b/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
--- a/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_buffer_cache.cpp
@@ -1,3 +1,4 @@
+#include <cstdio>
 #include "video_core/native_wait_profile.h"
 // SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
 // SPDX-License-Identifier: GPL-3.0-or-later
@@ -377,6 +378,11 @@
 }
 
 StagingBufferRef BufferCacheRuntime::UploadStagingBuffer(size_t size) {
+    // 0.5.5: which upload needs one block this large (48 MiB + 48 ended 0.3 to 0.5.4rc).
+    if (size > (size_t{16} << 20)) {
+        std::fprintf(stderr, "EDEN_BIG_UPLOAD kind=buffer size=%zu caller=%p\n", size,
+                     __builtin_return_address(0));
+    }
     return staging_pool.Request(size, MemoryUsage::Upload);
 }
 
diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.h b/src/video_core/renderer_vulkan/vk_rasterizer.h
--- a/src/video_core/renderer_vulkan/vk_rasterizer.h
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.h
@@ -270,7 +270,9 @@
     };
     std::vector<MeshArena> mesh_arenas;
     size_t mesh_arena_current{~size_t{}};
-    u64 mesh_arena_size{64ULL << 20};
+    // 0.5.5: 8 MiB, was 64 MiB. A submission's task output was at most 4.6 MiB (OoT, 2249
+    // submissions); each arena in flight is one contiguous block of the shared pool.
+    u64 mesh_arena_size{8ULL << 20};
     /// The current submission's arena, after its counter is reset.
     const MeshArena& AcquireMeshArena();
     /// Mesh emulation: the draw's staging buffers, held until its commands are recorded (Lichii #1452).
diff --git a/src/video_core/renderer_vulkan/vk_texture_cache.cpp b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
--- a/src/video_core/renderer_vulkan/vk_texture_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
@@ -1,3 +1,4 @@
+#include <cstdio>
 #include "video_core/renderer_vulkan/vk_sparse_image.h"
 // SPDX-FileCopyrightText: Copyright 2026 Eden Emulator Project
 // SPDX-License-Identifier: GPL-3.0-or-later
@@ -1127,6 +1128,11 @@
 }
 
 StagingBufferRef TextureCacheRuntime::UploadStagingBuffer(size_t size, bool deferred) {
+    // 0.5.5: which upload needs one block this large (48 MiB + 48 ended 0.3 to 0.5.4rc).
+    if (size > (size_t{16} << 20)) {
+        std::fprintf(stderr, "EDEN_BIG_UPLOAD kind=texture size=%zu deferred=%d caller=%p\n", size,
+                     deferred ? 1 : 0, __builtin_return_address(0));
+    }
     return staging_buffer_pool.Request(size, MemoryUsage::Upload, deferred);
 }
 
