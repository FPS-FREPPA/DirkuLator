From the 024 console run: 571 of the handle-zero cases were reported as "CompositeExtractU32x4
stopped_at=Phi", which hid what each path really loads from. The merge now keeps the blocker found
on its paths, and EDEN_TEXTURE_HANDLE_FALLBACK names the incoming values of a merged root
(paths=...) and the shader stage. Diagnostic only: no change to what is drawn.

diff --git a/src/shader_recompiler/ir_opt/texture_pass.cpp b/src/shader_recompiler/ir_opt/texture_pass.cpp
--- a/src/shader_recompiler/ir_opt/texture_pass.cpp
+++ b/src/shader_recompiler/ir_opt/texture_pass.cpp
@@ -597,7 +597,7 @@
                     if (extract(incoming.InstRecursive(), depth + 1)) return true;
                     code.resize(start);
                 }
-                g_handle_failure = IR::Opcode::Phi;
+                if (g_handle_failure == IR::Opcode::Void) g_handle_failure = IR::Opcode::Phi;
                 return false;
             }
             default:
@@ -1023,9 +1023,23 @@
             static std::atomic<u32> handle_fallbacks{};
             if (const u32 count = ++handle_fallbacks; count <= 1024 || (count & (count - 1)) == 0) {
