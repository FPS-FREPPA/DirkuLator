+
+    // EDEN_NX2_UNIFIED_MEMORY (/data/eden-nx2/unified-memory.txt): images, device-local buffers and
+    // upload buffers all take the memory types that are device local and host visible. On the
+    // console every allocation is one pool the CPU maps as well, but VMA keeps a separate set of
+    // 64 MiB blocks per memory type: in the 025 runs the device-local-only type held 460-970 MiB
+    // free inside its blocks when an upload buffer (another type) found the pool empty. Sharing
+    // one type lets each kind of allocation use the room another left. 0: the switch is off, or no
+    // such type exists, and every allocation keeps its usual types.
+    [[nodiscard]] u32 UnifiedMemoryTypes(const VkPhysicalDeviceMemoryProperties& properties) {
+        static const bool on = std::getenv("EDEN_NX2_UNIFIED_MEMORY") != nullptr;
+        if (!on) {
+            return 0;
+        }
+        constexpr VkMemoryPropertyFlags wanted = VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT |
+                                                 VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT |
+                                                 VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+        constexpr VkMemoryPropertyFlags unwanted = VK_MEMORY_PROPERTY_HOST_CACHED_BIT |
+                                                   VK_MEMORY_PROPERTY_LAZILY_ALLOCATED_BIT |
+                                                   VK_MEMORY_PROPERTY_PROTECTED_BIT;
+        u32 types = 0;
+        for (u32 type = 0; type < properties.memoryTypeCount; ++type) {
+            const VkMemoryPropertyFlags flags = properties.memoryTypes[type].propertyFlags;
+            if ((flags & wanted) == wanted && (flags & unwanted) == 0) {
+                types |= 1u << type;
+            }
+        }
+        static const bool logged = [types] {
+            LOG_WARNING(Render_Vulkan, "EDEN_UNIFIED_MEMORY memory types {:#x}", types);
+            return true;
+        }();
+        (void)logged;
+        return types;
+    }
+
+    // A buffer's memory types under EDEN_NX2_UNIFIED_MEMORY: device-local and upload buffers take
+    // the shared ones; readbacks keep their cached types.
+    [[nodiscard]] u32 SharedTypes(MemoryUsage usage, u32 valid,
+                                  const VkPhysicalDeviceMemoryProperties& properties) {
+        if (usage != MemoryUsage::DeviceLocal && usage != MemoryUsage::Upload) {
+            return valid;
+        }
+        const u32 shared = UnifiedMemoryTypes(properties) & valid;
+        return shared != 0 ? shared : valid;
+    }
 } // namespace
 
