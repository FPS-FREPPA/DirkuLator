+size_t RasterizerVulkan::SignalIdleFence() {
+    const size_t operations = fence_manager.UncommittedOperations();
+    const bool query_work = fence_manager.QueryFenceWork();
+    if (operations == 0 && !query_work) {
+        return 0;
+    }
+    // These operations must not retire through a stub fence: prior recorded GPU work
+    // must complete before query results or guest semaphore writes become visible.
+    fence_manager.SignalReference(true);
+    return operations != 0 ? operations : 1;
+}
+
+size_t RasterizerVulkan::PendingFenceOperations() {
+    return fence_manager.UncommittedOperations();
+}
+
+bool RasterizerVulkan::PendingQueryFenceWork() {
+    return fence_manager.QueryFenceWork();
+}
+
