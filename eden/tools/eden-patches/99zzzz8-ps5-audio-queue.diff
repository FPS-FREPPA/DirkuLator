PS5: keep 60 ms of rendered audio queued instead of 20 ms, and log how much of the output had no audio
ready (EDEN_AUDIO_SINK, every five seconds). OoT's music breaks up on the main menu, where a movie is
decoding on the CPU, but plays perfectly in gameplay; no host thread is pinned on a console where the
CPU topology cannot be read, so a stall of more than 20 ms repeated the last sample.

diff --git a/src/audio_core/adsp/apps/audio_renderer/audio_renderer.cpp b/src/audio_core/adsp/apps/audio_renderer/audio_renderer.cpp
--- a/src/audio_core/adsp/apps/audio_renderer/audio_renderer.cpp
+++ b/src/audio_core/adsp/apps/audio_renderer/audio_renderer.cpp
@@ -125,7 +125,13 @@
         std::string name{fmt::format("ADSP_RenderStream-{}", i)};
         streams[i] =
             sink.AcquireSinkStream(system, channels, name, ::AudioCore::Sink::StreamType::Render);
+#ifdef EDEN_NX2_PS5_PROTO
+        // 12 blocks of 5 ms. With 4, a host stall over 20 ms (a movie's decoder threads share the
+        // CPU, no thread is pinned where the topology cannot be read) repeats the last sample.
+        streams[i]->SetRingSize(12);
+#else
         streams[i]->SetRingSize(4);
+#endif
     }
 }
 
