+    if (type == StreamType::Render) {
+        sink_probe_frames += num_frames;
+        sink_probe_padded += num_frames - actual_frames_written;
+        if (sink_probe_frames >= TargetSampleRate * 5) {
+            std::fprintf(stderr, "EDEN_AUDIO_SINK name=%s frames=%llu padded=%llu queue_limit=%u\n", name.c_str(),
+                         static_cast<unsigned long long>(sink_probe_frames),
+                         static_cast<unsigned long long>(sink_probe_padded), max_queue_size);
+            sink_probe_frames = 0;
+            sink_probe_padded = 0;
+        }
+    }
+#endif
+
     {
