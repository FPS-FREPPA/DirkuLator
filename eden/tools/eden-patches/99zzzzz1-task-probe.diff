+void RasterizerVulkan::RecordTaskProbeCopy() {
+    task_probe.copy_pending = false;
+    constexpr u64 args_bytes{Shader::Backend::SPIRV::MESH_EMULATION_ARGS_WORDS * 4};
+    task_probe.args_copy = staging_pool.Request(args_bytes, MemoryUsage::Download);
+    task_probe.output_copy = staging_pool.Request(task_probe.output_bytes, MemoryUsage::Download);
+    scheduler.RequestOutsideRenderPassOperationContext();
+    scheduler.Record([arena = task_probe.arena, args_source = task_probe.args_source,
+                      args_offset = task_probe.args_offset, args_copy = task_probe.args_copy,
+                      output_copy = task_probe.output_copy,
+                      bytes = task_probe.output_bytes](vk::CommandBuffer cmdbuf) {
+        const VkMemoryBarrier written{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_SHADER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT,
+        };
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0,
+                               written);
+        cmdbuf.CopyBuffer(args_source, args_copy.buffer,
+                          VkBufferCopy{args_offset, args_copy.offset, args_bytes});
+        cmdbuf.CopyBuffer(arena, output_copy.buffer, VkBufferCopy{0, output_copy.offset, bytes});
+        const VkMemoryBarrier copied{
+            .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+            .pNext = nullptr,
+            .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+            .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+        };
+        cmdbuf.PipelineBarrier(VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, copied);
+    });
+    task_probe.tick = scheduler.CurrentTick();
+    task_probe.read_pending = true;
+}
