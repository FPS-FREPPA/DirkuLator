+template <class P>
+void TextureCache<P>::RecordCaptureBinds(std::span<const ImageViewInOut> views,
+                                         std::span<const ImageViewId> unreplaced, bool compute) {
+    namespace Trace = NativeDrawTrace;
+    const u64 sequence = Trace::capture_sequence++;
+    const bool watching = !Trace::CaptureWatch().empty();
+    // A watched image an earlier draw or dispatch touched: its state after that pass. Taken at a
+    // draw only, so the GPU wait never falls inside a compute dispatch's storage batch.
+    if (!compute && Trace::stage_post_pending) {
+        Trace::stage_post_pending = false;
+        CaptureStageSnapshot(ImageId{Trace::stage_post_image}, "post", Trace::stage_post_sequence);
+    }
+    u64 rt0 = 0;
+    u32 rt0_format = 0;
+    if (!compute && maxwell3d != nullptr) {
+        const auto& regs = maxwell3d->regs;
+        if (regs.rt_control.count > 0) {
+            const auto& rt = regs.rt[regs.rt_control.Map(0)];
+            if (rt.format != Tegra::RenderTargetFormat::NONE) {
+                rt0 = rt.Address();
+                rt0_format = static_cast<u32>(rt.format);
+            }
+        }
+    }
+    ImageId touched{};
+    bool rt0_logged = false;
+    for (size_t i = 0; i < views.size(); ++i) {
+        const ImageViewId view_id = views[i].id;
+        if (view_id == NULL_IMAGE_VIEW_ID) {
+            continue;
+        }
+        const ImageViewBase& image_view = slot_image_views[view_id];
+        if (image_view.IsBuffer() || !image_view.image_id) {
+            continue;
+        }
+        const Image& image = slot_images[image_view.image_id];
+        const bool substituted = i < unreplaced.size() && unreplaced[i] != view_id;
+        const Trace::Read read{image.gpu_addr,
+                               static_cast<u32>(image_view.range.base.layer),
+                               static_cast<u32>(image_view.range.extent.layers),
+                               Trace::current_writer,
+                               static_cast<u32>(image.info.format),
+                               static_cast<u32>(image_view.format),
+                               substituted};
+        if (Trace::capture_reads.size() < (1u << 20)) {
+            Trace::capture_reads.push_back(read);
+        }
+        if (!watching || !Trace::IsWatched(image.gpu_addr)) {
+            continue;
+        }
+        // The guest image behind a feedback copy: the one the draw writes.
+        ImageId source = image_view.image_id;
+        if (substituted && unreplaced[i] != NULL_IMAGE_VIEW_ID) {
+            source = slot_image_views[unreplaced[i]].image_id;
+        }
+        if (!touched) {
+            touched = source;
+        }
+        rt0_logged |= rt0 == image.gpu_addr;
+        if (Trace::capture_sequence_log.size() < 4096) {
+            Trace::capture_sequence_log.push_back({sequence, compute, Trace::current_writer, rt0, rt0_format, read,
+                                                   image_view.image_id.index, source.index});
+        }
+    }
+    if (watching && rt0 != 0 && !rt0_logged && Trace::IsWatched(rt0) &&
+        Trace::capture_sequence_log.size() < 4096) {
+        // Renders to a watched image without sampling it.
+        Trace::capture_sequence_log.push_back({sequence, compute, Trace::current_writer, rt0, rt0_format, {}, 0, 0});
+    }
+    if (touched) {
+        if (!compute) {
+            CaptureStageSnapshot(touched, "pre", sequence);
+        }
+        Trace::stage_post_pending = true;
+        Trace::stage_post_image = touched.index;
+        Trace::stage_post_sequence = sequence;
+    }
+}
