+template <class P>
+void TextureCache<P>::CaptureStageSnapshot(ImageId image_id, const char* when, u64 sequence) {
+    namespace Trace = NativeDrawTrace;
+    static const char* const capture_dir = std::getenv("EDEN_NX2_CAPTURE_DIR");
+    if (capture_dir == nullptr || Trace::stage_count >= Trace::kStageLimit) {
+        return;
+    }
+    Image& image = slot_images[image_id];
+    const auto& info = image.info;
+    if (info.type != ImageType::e2D || info.num_samples != 1 || !image.unswizzled_size_bytes ||
+        image.unswizzled_size_bytes > 64_MiB ||
+        True(image.flags & (ImageFlagBits::Unbacked | ImageFlagBits::IsDecoding))) {
+        return;
+    }
+    const std::filesystem::path folder = std::filesystem::path{capture_dir} / "stages-pending";
+    auto map = runtime.DownloadStagingBuffer(image.unswizzled_size_bytes);
+    const auto copies = FixSmallVectorADL(FullDownloadCopies(info));
+    image.DownloadMemory(map, copies);
+    runtime.Finish();
+    const u32 order = Trace::stage_count++;
+    const std::string name = fmt::format("{:02}-seq{}-{}-{:x}-f{}-{}x{}.raw", order, sequence, when, image.gpu_addr,
+                                         static_cast<u32>(info.format), info.size.width, info.size.height);
+    std::ofstream raw(folder / name, std::ios::binary);
+    raw.write(reinterpret_cast<const char*>(map.mapped_span.data()),
+              static_cast<std::streamsize>(image.unswizzled_size_bytes));
+    const auto& first = copies.front();
+    std::ofstream index(folder / "index.txt", std::ios::app);
+    index << order << ' ' << fmt::format("{:#x}", image.gpu_addr) << ' ' << static_cast<u32>(info.format) << ' '
+          << info.size.width << ' ' << info.size.height << ' ' << info.resources.layers << ' '
+          << info.resources.levels << ' ' << image.unswizzled_size_bytes << ' ' << first.buffer_offset << ' '
+          << first.buffer_row_length << ' ' << first.buffer_image_height << ' ' << image.modification_tick << ' '
+          << fmt::format("{:#x}", static_cast<u32>(image.flags)) << ' ' << name << '\n';
 }
 
