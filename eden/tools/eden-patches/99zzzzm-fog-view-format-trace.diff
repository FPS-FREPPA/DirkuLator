+/// Watched guest addresses, parsed once from EDEN_NX2_CAPTURE_WATCH (hex, separated by commas).
+inline const std::vector<u64>& CaptureWatch() {
+    static const std::vector<u64> watch = [] {
+        std::vector<u64> addresses;
+        if (const char* value = std::getenv("EDEN_NX2_CAPTURE_WATCH")) {
+            const char* p = value;
+            while (*p) {
+                char* end = nullptr;
+                const u64 address = std::strtoull(p, &end, 16);
+                if (end == p) {
+                    ++p;
+                    continue;
+                }
+                if (address) addresses.push_back(address);
+                p = end;
+            }
+        }
+        return addresses;
+    }();
+    return watch;
+}
+inline bool IsWatched(u64 address) {
+    for (const u64 watched : CaptureWatch()) {
+        if (watched == address) return true;
+    }
+    return false;
+}
