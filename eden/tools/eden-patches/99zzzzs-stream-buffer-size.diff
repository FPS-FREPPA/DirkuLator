@@ -40,6 +41,12 @@
 #endif
 
 size_t GetStreamBufferSize(const Device& device) {
+    if (const char* value = std::getenv("EDEN_NX2_STREAM_BUFFER_MIB")) {
+        const unsigned long long mib = std::strtoull(value, nullptr, 10);
+        if (mib >= 8 && mib <= 256) {
+            return static_cast<size_t>(mib) << 20;
