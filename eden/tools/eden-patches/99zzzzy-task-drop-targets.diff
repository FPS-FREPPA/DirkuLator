diff --git a/src/video_core/renderer_vulkan/vk_rasterizer.cpp b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
--- a/src/video_core/renderer_vulkan/vk_rasterizer.cpp
+++ b/src/video_core/renderer_vulkan/vk_rasterizer.cpp
@@ -501,6 +501,91 @@
         // Native task/mesh is not used here, and an indirect emulated draw has no group count to
         // size its output by. Nothing waits on the dropped draw.
         static std::atomic<u64> dropped{};
+        // 045: where the dropped task draws would have drawn (GPU thread only).
+        struct DropTarget {
+            u64 zeta;
+            u64 rt0;
+            u32 zeta_on;
+            u32 format;
+            u32 width;
+            u32 height;
+            u32 layers;
+            u32 depth_state; // bit 0 test, bit 1 write, bits 4+ compare function
+            u64 count;
+        };
+        struct DropTable {
+            std::array<DropTarget, 32> targets{};
+            u64 other{};
+            u64 total{};
+        };
+        static DropTable drop_all{};
+        static DropTable drop_capture{};
+        static bool drop_capture_armed{};
+        static u32 drop_capture_number{};
+        const auto print_drops = [](const char* tag, const DropTable& table, u32 number) {
+            for (const auto& target : table.targets) {
+                if (target.count == 0) {
+                    continue;
+                }
+                std::fprintf(stderr,
+                             "%s n=%u zeta=%llx zeta_on=%u format=%u size=%ux%u layers=%u depth_test=%u depth_write=%u "
+                             "depth_func=%u rt0=%llx count=%llu\n",
+                             tag, number, static_cast<unsigned long long>(target.zeta), target.zeta_on, target.format,
+                             target.width, target.height, target.layers, target.depth_state & 1,
+                             (target.depth_state >> 1) & 1, target.depth_state >> 4,
+                             static_cast<unsigned long long>(target.rt0), static_cast<unsigned long long>(target.count));
+            }
+            std::fprintf(stderr, "%s n=%u total=%llu other=%llu\n", tag, number,
+                         static_cast<unsigned long long>(table.total), static_cast<unsigned long long>(table.other));
+        };
+        // A capture arms one frame (NativeDrawTrace::capture_reads_armed) and the texture cache disarms it at
+        // the frame's end: the drops in between belong to the captured frame.
+        const bool capture_armed = VideoCommon::NativeDrawTrace::capture_reads_armed;
+        if (capture_armed != drop_capture_armed) {
+            if (drop_capture_armed) {
+                print_drops("EDEN_TASK_DROP_CAPTURE", drop_capture, drop_capture_number++);
+            }
+            drop_capture = {};
+            drop_capture_armed = capture_armed;
+        }
+        if (dropped_task) {
+            const auto& drop_regs = maxwell3d->regs;
+            const DropTarget seen{
+                drop_regs.zeta.Address(),
+                drop_regs.rt[0].Address(),
+                drop_regs.zeta_enable ? 1U : 0U,
+                static_cast<u32>(drop_regs.zeta.format),
+                drop_regs.zeta_size.width,
+                drop_regs.zeta_size.height,
+                drop_regs.zeta_size.dim_control == Maxwell::ZetaSize::DimensionControl::ArraySizeIsOne
+                    ? 1U : static_cast<u32>(drop_regs.zeta_size.depth),
+                (drop_regs.depth_test_enable ? 1U : 0U) | (drop_regs.depth_write_enabled ? 2U : 0U) |
+                    (static_cast<u32>(drop_regs.depth_test_func) << 4),
+                0};
+            const auto record = [&seen](DropTable& table) {
+                ++table.total;
+                for (auto& target : table.targets) {
+                    if (target.count == 0) {
+                        target = seen;
+                    } else if (target.zeta != seen.zeta || target.rt0 != seen.rt0 ||
+                               target.zeta_on != seen.zeta_on || target.format != seen.format ||
+                               target.width != seen.width || target.height != seen.height ||
+                               target.layers != seen.layers || target.depth_state != seen.depth_state) {
+                        continue;
+                    }
+                    ++target.count;
+                    return;
+                }
+                ++table.other;
+            };
+            record(drop_all);
+            if (capture_armed) {
+                record(drop_capture);
+            }
+            if (drop_all.total == 1 || drop_all.total % 4096 == 0) {
+                print_drops("EDEN_TASK_DROP_TARGET", drop_all, 0);
+            }
+        }
         if (const u64 count = ++dropped; count <= 8 || count % 4096 == 0) {
             const char* const reason = dropped_task ? "task" : direct_instances == 0 ? "indirect" : "unsupported";
             LOG_WARNING(Render_Vulkan, "EDEN_MESH_DRAW_DROPPED {} count={}", reason, count);
